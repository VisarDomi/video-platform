{
  "name": "tango-explorer",
  "version": "235",
  "description": "A lightweight userscript that makes exploring Tango streams easy",
  "type": "module",
  "scripts": {
    "build": "node increase.js && vite build",
    "tests": "node tests/ios/run.mjs",
    "tests:smoke": "node tests/ios/run.mjs --smoke",
    "tests:server": "python3 tests/ios/bridge_server.py",
    "tests:setup": "python3 tests/ios/bridge_server.py --setup"
  },
  "devDependencies": {
    "@types/tampermonkey": "^5.0.4",
    "nodemon": "^3.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-monkey": "^7.1.4"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
