{
  "name": "stream-viewer",
  "version": "240",
  "description": "A lightweight userscript that makes exploring live streams easy",
  "type": "module",
  "scripts": {
    "build": "node increase.js && vite build",
    "tests": "node tests/ios/run.mjs",
    "tests:smoke": "node tests/ios/run.mjs --smoke",
    "tests:actions": "node tests/ios/run.mjs --actions",
    "tests:server": "userscript-ios-test server --config tests/ios/config.json",
    "tests:setup": "userscript-ios-test setup --config tests/ios/config.json"
  },
  "devDependencies": {
    "@types/tampermonkey": "^5.0.4",
    "nodemon": "^3.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-monkey": "^7.1.4",
    "userscript-ios-test": "file:../../userscript-ios-test"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
