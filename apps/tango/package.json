{
  "name": "stream-viewer",
  "version": "259",
  "description": "A lightweight viewer for Tango live streams and XVideos uploads",
  "type": "module",
  "scripts": {
    "build": "node increase.js && vite build",
    "build:extension": "node scripts/build-extension.mjs",
    "tests:extension": "npm run build:extension && node tests/extension.mjs && node tests/xvideos.mjs && node tests/cookies.mjs",
    "tests": "node tests/ios/run.mjs",
    "tests:smoke": "node tests/ios/run.mjs --smoke",
    "tests:actions": "node tests/ios/run.mjs --actions"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-monkey": "^7.1.4",
    "userscript-ios-test": "file:../../userscript-ios-test"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
