[Unit]
Description=Video Server
After=network.target video-xvfb.service
Wants=video-xvfb.service

[Service]
Type=simple
ExecStart="{{HOME}}/.local/bin/video-server"
# node:sqlite (the finalization checkpoints) prints an ExperimentalWarning at every start.
Environment=NODE_OPTIONS=--disable-warning=ExperimentalWarning
Environment=DISPLAY=:111
Environment=PLAYWRIGHT_BROWSERS_PATH=0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
