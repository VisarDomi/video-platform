{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "./dist/backend",
        "module": "ESNext",
        "moduleResolution": "node",
        "noEmit": false,
        "sourceMap": true,
        "allowImportingTsExtensions": false,
        "allowSyntheticDefaultImports": true
    },
    "include": ["src/backend"],
    "exclude": ["node_modules", "**/*.spec.ts"]
}
