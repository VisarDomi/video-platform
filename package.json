{
    "name": "video-segment-fetcher",
    "type": "module",
    "version": "1.0.0",
    "description": "Download 1s .ts files for each of the streamers you follow",
    "main": "main.ts",
    "scripts": {
        "build": "rm -rf dist && tsc",
        "start": "npm run build && pm2 start dist/main.js --name video-segment-fetcher",
        "restart": "npm run build && pm2 restart video-segment-fetcher",
        "stop": "pm2 stop video-segment-fetcher",
        "logs": "pm2 logs video-segment-fetcher -f",
        "tests": "cross-env NODE_OPTIONS='--no-warnings --experimental-vm-modules' jest"
    },
    "keywords": [],
    "author": "visardomi4@gmail.com",
    "license": "MIT",
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "20.8.10",
        "cross-env": "^10.1.0",
        "jest": "^29.7.0",
        "nodemon": "^3.1.10",
        "ts-jest": "^29.4.4",
        "typescript": "5.2.2"
    },
    "dependencies": {
        "winston": "^3.17.0"
    }
}