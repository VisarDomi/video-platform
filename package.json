{
    "name": "video-editor-dev",
    "version": "1.0.0",
    "description": "Backend server for viewing and editing videos.",
    "main": "dist/server.js",
    "type": "module",
    "scripts": {
        "build": "rm -rf dist && tsc",
        "start": "npm run build && pm2 start dist/server.js --name video-editor-dev",
        "restart": "npm run build && pm2 restart video-editor-dev",
        "stop": "pm2 stop video-editor-dev",
        "logs": "pm2 logs video-editor-dev -f"
    },
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.3",
        "@types/node": "^20.12.7",
        "typescript": "^5.4.5"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^5.1.0",
        "p-limit": "^7.1.1",
        "winston": "^3.13.0"
    }
}
