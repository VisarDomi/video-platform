{
    "name": "tango-downloader",
    "type": "module",
    "version": "1.0.0",
    "description": "Download from tango",
    "main": "main.ts",
    "scripts": {
        "build": "rm -rf dist && tsc",
        "start": "npm run build && pm2 start dist/main.js --name tango-downloader",
        "restart": "npm run build && pm2 restart tango-downloader",
        "stop": "pm2 stop tango-downloader",
        "logs": "pm2 logs tango-downloader -f",
        "tests": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles"
    },
    "keywords": [],
    "author": "visardomi4@gmail.com",
    "license": "MIT",
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "20.8.10",
        "cross-env": "^10.1.0",
        "jest": "^29.7.0",
        "nodemon": "^3.1.10",
        "ts-jest": "^29.4.4",
        "typescript": "5.2.2"
    },
    "dependencies": {
        "winston": "^3.17.0"
    }
}