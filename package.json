{
    "name": "tango-auth",
    "type": "module",
    "version": "1.0.0",
    "description": "Get and update tokens used by other tango microservices",
    "main": "main.ts",
    "scripts": {
        "build": "rm -rf dist && tsc",
        "start": "npm run build && systemctl --user start tango-auth",
        "restart": "npm run build && systemctl --user restart tango-auth",
        "stop": "systemctl --user stop tango-auth",
        "logs": "journalctl --user -u tango-auth -f",
        "postinstall": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium"
    },
    "keywords": [],
    "author": "visardomi4@gmail.com",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "20.8.10",
        "nodemon": "^3.1.10",
        "ts-node": "^10.9.2",
        "typescript": "5.2.2"
    },
    "dependencies": {
        "dotenv": "^17.2.2",
        "playwright": "^1.56.0",
        "winston": "^3.17.0"
    }
}