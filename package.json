{
    "name": "tango-editor-backend",
    "version": "1.0.0",
    "description": "Backend server for viewing and editing Tango videos.",
    "main": "dist/server.js",
    "type": "module",
    "scripts": {
        "build": "rm -rf dist && tsc",
        "start": "pm2 start dist/server.js --name tango-editor-backend",
        "dev": "npm run build && node --watch dist/server.js",
        "restart": "npm run build && pm2 restart tango-editor-backend",
        "stop": "pm2 stop tango-editor-backend",
        "logs": "pm2 logs tango-editor-backend -f"
    },
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.3",
        "@types/node": "^20.12.7",
        "typescript": "^5.4.5"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^5.1.0",
        "winston": "^3.13.0"
    }
}
