{
    "watch": ["."],
    "ext": "js,jsx,ts,tsx,html,css,scss,json,md,yml",
    "ignore": [
        ".git",
        "node_modules/**/node_modules",
        "dist/*",
        "build/*",
        "repomix/repomix-output.xml",
        "convert.sh",
        "session.json",
        "error.log",
        "live-status.json",
        "postman/*"
    ],
    "exec": "repomix --config repomix.config.json",
    "verbose": false
}
