{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Program",
      "program": "${workspaceFolder}/src/tango.ts",
      "preLaunchTask": "npm: build",
      "runtimeArgs": ["--env-file=.env"], // Load ts-node and env
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "sourceMaps": true,
      "envFile": "${workspaceFolder}/.env" // Load environment variables from the .env file
    }
  ]
}
