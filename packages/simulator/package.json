{
    "name": "simulator",
    "version": "1.0.0",
    "description": "Simulated live-streaming sites with scripted faults and a ground-truth log, for end-to-end tests of the capture pipeline.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "bin": {
        "simulator": "dist/cli.js"
    },
    "scripts": {
        "build": "rm -rf dist && tsc",
        "test": "npm run build && node --test test/*.test.mjs"
    },
    "devDependencies": {
        "@types/node": "^22.19.0",
        "typescript": "^5.4.5"
    }
}
