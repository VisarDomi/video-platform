{
    "name": "demo",
    "description": "Three live sites with tennis channels going on and off air, and a fault every few minutes (session-scoped, so every session repeats them); a file host serving prepared matches; two upload destinations with processing, removals, notices, cache windows, quotas and forced logouts.",
    "seed": "demo-1",
    "epoch": null,
    "segmentRetentionS": 120,
    "sites": {
        "ts-live": {
            "accounts": [{ "username": "demo", "password": "demo", "accountId": "acct-demo" }],
            "streamTokenTtlS": 10,
            "channels": [
                {
                    "id": "acct-centre", "name": "centre-court",
                    "schedule": { "cycle": { "periodS": 3600, "onlineS": 2700 } },
                    "faults": [
                        { "type": "playlistStatus", "scope": "session", "at": "5m", "until": "5m20s", "status": 503 },
                        { "type": "restart", "scope": "session", "at": "12m", "value": 0 },
                        { "type": "damage", "scope": "session", "at": "20m", "until": "20m10s", "kind": "single-frame", "every": 3 },
                        { "type": "codecChange", "scope": "session", "at": "30m", "until": "31m" }
                    ]
                },
                {
                    "id": "acct-court-two", "name": "court-two",
                    "schedule": { "cycle": { "periodS": 1800, "onlineS": 1200, "offsetS": 300 } },
                    "renames": [{ "at": "2h", "name": "court-two-evening" }],
                    "faults": [{ "type": "skip", "scope": "session", "at": "8m", "count": 4 }]
                }
            ],
            "faults": [{ "type": "tokenRevoke", "at": "40m" }]
        },
        "ladder-live": {
            "pageSize": 50,
            "channels": [
                {
                    "id": "1001", "name": "clay-court-one",
                    "schedule": { "cycle": { "periodS": 2400, "onlineS": 1800 } },
                    "faults": [
                        { "type": "restart", "scope": "session", "at": "10m", "value": 1 },
                        { "type": "paid", "scope": "session", "at": "25m", "until": "26m" }
                    ]
                },
                { "id": "1002", "name": "clay-court-two", "schedule": { "always": true } }
            ]
        },
        "fmp4-live": {
            "edges": ["a", "b", "c"],
            "obfuscation": { "keys": { "k1": "demo-key-one", "k2": "demo-key-two" }, "keyId": "k1" },
            "channels": [
                {
                    "id": "501", "name": "hard-court-one", "obfuscated": true,
                    "schedule": { "cycle": { "periodS": 3000, "onlineS": 2400 } },
                    "renames": [{ "at": "90m", "name": "hard-court-main" }],
                    "faults": [
                        { "type": "edgeOutage", "scope": "session", "edge": "b", "at": "4m", "until": "6m", "status": 403 },
                        { "type": "edgeOutage", "scope": "session", "edge": "a", "at": "15m", "until": "15m30s", "status": 404 },
                        { "type": "damage", "scope": "session", "at": "9m", "until": "9m30s", "kind": "zero-size-sample", "every": 2 },
                        { "type": "showState", "scope": "session", "at": "18m", "until": "18m45s", "state": "group" },
                        { "type": "segmentStatus", "scope": "session", "at": "22m", "until": "24m", "status": 429, "ratio": 0.3 }
                    ]
                },
                { "id": "502", "name": "hard-court-two", "schedule": { "always": true } }
            ],
            "faults": [{ "type": "obfuscationKey", "at": "1h", "keyId": "k2" }]
        },
        "file-host": {
            "albums": [{ "id": "day-one", "title": "Day one, full matches" }],
            "files": [
                { "id": "m1a7Qx", "name": "First round, court one.mp4", "album": "day-one" },
                { "id": "m2b8Ry", "name": "First round, court two.mp4", "album": "day-one", "at": "5m" },
                { "id": "m3c9Sz", "name": "Practice session.mp4" }
            ],
            "signatureTtlS": 120,
            "redirectHops": 1,
            "faults": [
                { "type": "transferStall", "at": "10m", "until": "12m", "mode": "stall", "afterBytes": 1048576, "stallS": 90 },
                { "type": "transferStall", "at": "20m", "until": "21m", "mode": "cut", "afterBytes": 4194304, "file": "m1a7Qx" },
                { "type": "etagChange", "at": "40m", "file": "m3c9Sz" }
            ]
        },
        "form-host": {
            "accounts": [{ "username": "demo", "password": "demo-password", "displayName": "Demo" }],
            "processingS": 180,
            "processingRules": [{ "titleMatches": "\\bfail\\b", "outcome": "failed", "recoverAfterS": 600 }],
            "removals": [{ "shorterThanS": 120, "afterS": 1800, "reason": "too short" }],
            "bannedWords": [{ "word": "Brandname", "action": "refuse" }, { "word": "Sponsor", "action": "replace-notice", "replacement": "partner" }],
            "visibilityRules": [{ "word": "walkover", "reason": "incomplete match" }],
            "faults": [
                { "type": "cacheWindow", "at": "20m", "until": "22m", "path": "/upload-video/" },
                { "type": "chunkFault", "at": "30m", "until": "35m", "mode": "drop", "ratio": 0.2 },
                { "type": "listStatus", "at": "45m", "until": "45m10s", "status": 404 },
                { "type": "logout", "at": "1h" }
            ]
        },
        "api-host": {
            "accounts": [{ "username": "demo", "password": "demo-password" }],
            "rotateRefreshTokens": true,
            "accessTokenTtlS": 900,
            "processingS": 120,
            "minDurationS": 60,
            "bannedWords": [{ "word": "Brandname" }],
            "removals": [{ "titleMatches": "\\breject me\\b", "afterS": 600, "kind": "rejected", "reason": "rights holder" }],
            "quota": { "dailyUnits": 10000 },
            "faults": [
                { "type": "uploadFault", "at": "15m", "until": "16m", "mode": "drop", "ratio": 0.3 },
                { "type": "apiStatus", "at": "25m", "until": "25m30s", "status": 503, "api": "videos" },
                { "type": "revokeTokens", "at": "2h" }
            ]
        }
    }
}
