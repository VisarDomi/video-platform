{
    "name": "descriptor",
    "type": "module",
    "version": "1.0.0",
    "private": true,
    "description": "Local native-video description engine",
    "main": "dist/index.js",
    "types": "src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "rm -rf dist && tsc",
        "test": "npm run build && node --test test/*.test.mjs",
        "describe-one": "npm run build && node dist/describe-one.js",
        "describe-one:bounded": "npm run build && node scripts/run-bounded-describe-one.mjs",
        "runtime:install": "node scripts/install-runtime.mjs",
        "runtime:activate": "node scripts/activate-runtime.mjs"
    },
    "license": "MIT",
    "devDependencies": {
        "@types/node": "20.8.10",
        "typescript": "5.2.2"
    }
}
