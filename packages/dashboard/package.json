{
	"name": "dashboard",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"server:dev": "tsx server/index.ts",
		"server:build": "rm -rf dist-server && tsc -p tsconfig.server.json",
		"start": "npm run server:build && systemctl --user start video-dashboard",
		"restart": "npm run server:build && systemctl --user restart video-dashboard",
		"stop": "systemctl --user stop video-dashboard",
		"logs": "journalctl --user -u video-dashboard -f"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.3",
		"@types/node": "^25.2.2",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"tsx": "^4.19.4",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"cors": "^2.8.5",
		"express": "^5.1.0"
	}
}
