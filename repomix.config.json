{
    "output": {
        "filePath": "repomix-output.xml",
        "style": "xml"
    },
    "include": [
        "**/*.js",
        "**/*.jsx",
        "**/*.ts",
        "**/*.tsx",
        "**/*.html",
        "**/*.css",
        "**/*.scss",
        "**/*.json",
        "**/*.md",
        "**/Dockerfile",
        "**/*.yml",
        ".env.template"
    ],
    "ignore": {
        "useGitignore": true,
        "useDefaultPatterns": true,
        "customPatterns": [
            "node_modules/**",
            ".git/**",
            "dist/**",
            "build/**",
            "coverage/**",
            "package-lock.json",
            "repomix-output.xml",
            "repomix.config.json",
            "nodemon.json",
            ".gitignore",
            "LICENSE",
            "temp.txt",
            "*.mp4",
            "convert.sh",
            "session.json",
            "live-status.json",
            "postman/**"
        ]
    }
}
