# The always-on demo as a rootless Quadlet unit. Copy this file and
# video-platform-demo.yaml to ~/.config/containers/systemd/, then:
#   systemctl --user daemon-reload && systemctl --user start video-platform-demo
# With lingering enabled (loginctl enable-linger), it comes back after a reboot or a
# power cut; the supervisor in the pod restarts any service that exits.
[Unit]
Description=Video platform demo against its simulated sites
Wants=network-online.target
After=network-online.target

[Kube]
Yaml=video-platform-demo.yaml

[Service]
Restart=always
TimeoutStopSec=90

[Install]
WantedBy=default.target
